{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": true,
    "dynamic_templates": [
      {
        "dq_text_fields": {
          "match": "*_t",
          "mapping": {
            "type": "text"
          }
        }
      },
      {
        "dq_string_fields": {
          "match": "*_s",
          "mapping": {
            "type": "keyword"
          }
        }
      },
      {
        "dq_date_fields": {
          "match": "*_dt",
          "mapping": {
            "type": "date"
          }
        }
      }
    ],
    "properties": {
      "id": {
        "type": "keyword"
      }
    }
  }
}
