#!/bin/sh
# Check the same python3 on PATH used by bin/dq, even when Python is missing.
if [ "$#" -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
    echo "Usage: verify-python"
    echo "Checks python3 on PATH, the same interpreter used by bin/dq."
    exit 0
fi
if [ "$#" -ne 0 ]; then
    echo "Usage: verify-python (no arguments; checks python3 on PATH)" >&2
    exit 2
fi
dq_python_command="python3"
if ! command -v "$dq_python_command" >/dev/null 2>&1; then
    echo "FAIL: $dq_python_command was not found. Use Python 3.4.10 or newer." >&2
    exit 1
fi

exec "$dq_python_command" -B - "$0" <<'PY'

import sys

print("Python executable: " + sys.executable)
print("Python version: " + sys.version.split()[0])
if sys.version_info < (3, 4, 10):
    print("FAIL: DQ requires Python 3.4.10 or newer. Update python3 on PATH or activate a suitable virtual environment.", file=sys.stderr)
    sys.exit(1)

try:
    import os
    import ssl

    project = os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1])))
    source = os.path.join(project, "src")
    if not os.path.isfile(os.path.join(source, "dq", "cli.py")):
        raise RuntimeError("DQ source is missing: keep bin/verify-python inside the project checkout")
    sys.path.insert(0, str(source))
    from dq import __version__
    from dq.cli import build_parser

    build_parser()
except Exception as error:
    print("FAIL: Cannot load DQ: " + str(error), file=sys.stderr)
    sys.exit(1)

print("DQ checkout: " + str(project))
print("DQ version: " + __version__)
print("HTTPS support: " + ssl.OPENSSL_VERSION)
print("PASS: Python meets DQ's requirements and the CLI loads successfully.")
PY
